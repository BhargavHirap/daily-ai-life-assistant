NEXT_PUBLIC_APP_NAME=Daylight
# Optional: add an OpenAI API key to enable full AI responses. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint base URL, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
